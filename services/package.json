{
  "name": "@mpb/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "indexer": "tsx --env-file-if-exists=.env src/indexer/main.ts",
    "keeper": "tsx --env-file-if-exists=.env src/keeper/main.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:up": "docker compose up -d postgres",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "healthcheck": "node dist/healthcheck.js",
    "e2e:localnet": "tsx scripts/e2e-localnet.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "^0.1.8",
    "@mpb/sdk": "workspace:*",
    "@pump-fun/pump-sdk": "4.3.1",
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "hono": "^4.13.16",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.1.2",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
