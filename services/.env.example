# ---------------------------------------------------------------------------
# @mpb/services environment. Copy to services/.env (loaded by the pnpm scripts).
# Every variable is optional unless marked REQUIRED for a given mode.
# ---------------------------------------------------------------------------

# --- HTTP ---
PORT=8787                         # API port (SPEC default 8787; the Docker image sets 8080)
HOST=0.0.0.0
PUBLIC_API_URL=                   # public URL of this API (prod: https://api.pixelframe.tech); default http://localhost:$PORT. Used for /files/* URLs.
PUBLIC_API_URL_ALIASES=           # comma list of former API origins (prod: https://api.pixelburn.applicure.io). On-chain /files/ URIs on them still resolve; see docs/domain-cutover.md
CORS_ORIGINS=http://localhost:3000  # comma list, or * (prod: https://pixelframe.tech,https://www.pixelframe.tech,https://pixelburn.applicure.io)
TRUST_PROXY=0                     # 1 = use X-Forwarded-For for rate limiting (set 1 behind Traefik)
LOG_LEVEL=info                    # debug | info | warn | error. Secrets (RPC URL, keys, tokens, DB password) are always redacted.
# Legacy aliases still accepted: PUBLIC_BASE_URL (= PUBLIC_API_URL), WEB_ORIGIN (= CORS_ORIGINS)

# --- Database (REQUIRED) ---
# docker compose up -d postgres   -> postgres://mpb:mpb@127.0.0.1:54329/mpb
DATABASE_URL=postgres://mpb:mpb@127.0.0.1:54329/mpb
# Test suite only (vitest); defaults to DATABASE_URL with db name mpb_test
TEST_DATABASE_URL=

# --- Solana ---
SOLANA_CLUSTER=devnet             # devnet | mainnet-beta (selects Helius hosts + public fallback RPC)
SOLANA_RPC=                       # SECRET. Full https RPC URL incl. key (QuickNode). Used for all HTTP RPC.
SOLANA_RPC_HELIUS_KEY=            # SECRET. Helius key: websockets (wss://<cluster>.helius-rpc.com/?api-key=...), HTTP fallback.
RPC_URL=                          # optional override of the HTTP RPC (e.g. http://127.0.0.1:8899 for a local validator)
WS_URL=                           # optional override of the websocket RPC
# HTTP: RPC_URL > SOLANA_RPC > Helius > public cluster RPC.   WS: WS_URL > Helius > derived from HTTP RPC.
PROGRAM_ID=                       # pixel program id. Unset = no indexer, no hydration, no on-chain reads
TOKEN_MINT=                       # $PXL mint (for supply + keeper quotes)
TOKEN_DECIMALS=6

# --- Indexer ---
INDEXER_ENABLED=0                 # 1 = also run the indexer inside the API process. Prod: use the separate `indexer` container.
                                  # Either way only ONE indexer is active (Postgres advisory lock); others wait.
INDEXER_BACKFILL_INTERVAL_MS=60000  # finalized gap-fill/backfill cadence
INDEXER_DROP_AFTER_SECS=180       # provisional tx with no status after this long is treated as dropped (rolled back)
HELIUS_WEBHOOK_SECRET=            # enables POST /webhooks/helius; must equal the webhook's Authorization header value

# --- Admin / moderation ---
ADMIN_TOKEN=                      # bearer token for /api/admin/*; unset = admin endpoints disabled (503)
AUTO_APPROVE=0                    # 1 = approve ads that pass all automatic checks (no human review)
BLOCKLIST_FILE=./data/blocklist.txt
DRAINER_LIST_FILE=./data/drainers.txt
DRAINER_LIST_URL=                 # optional remote drainer list (newline list or JSON array), refreshed every 30 min
IMAGE_HOSTS=arweave.net,gateway.irys.xyz,devnet.irys.xyz,node1.irys.xyz,node2.irys.xyz  # SSRF allow-list for image fetches

# --- Storage ---
IRYS_KEY=                         # base58 Solana secret key funding Irys uploads; unset = local disk fallback (/files/*)
IRYS_NETWORK=devnet               # devnet | mainnet
IRYS_RPC_URL=                     # RPC used by Irys for funding; defaults to the resolved HTTP RPC
ARWEAVE_GATEWAY=https://arweave.net   # resolves ar://<id> image URIs. Mainnet: https://gateway.irys.xyz, which has an upload immediately (docs/mainnet-cutover.md)
DATA_DIR=./var                    # ONE persistent dir: files/ (local uploads) + cache/ (images, canvas.png). Docker: /data

# --- Pricing ---
HERMES_URL=https://hermes.pyth.network
# SOL/USD: without HERMES_API_KEY it is read on-chain from the Pyth sponsored PriceUpdateV2 account
# (same account the program reads; no key needed). With a key, Hermes is used instead.
PYTH_SOL_USD_ACCOUNT=             # override of the sponsored feed account (default 7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE via @mpb/sdk)
SOL_PRICE_MAX_AGE_SECS=120        # quotes fail (503) if the on-chain price is older (program would reject too)
HERMES_API_KEY=                   # Pyth Hermes bearer token (Hermes returns 401 without one as of 2026-11)
SOL_USD_FALLBACK=                 # DEV ONLY: SOL/USD if the live source fails. Ignored when NODE_ENV=production.
TOKEN_PRICE_SOURCE=auto          # auto (= onchain when PROGRAM_ID is set) | onchain (curve/pool reserves + EMAs via @mpb/sdk) | static (dev)
TOKEN_PRICE_SOL_STATIC=0.0000125  # SOL per whole token when TOKEN_PRICE_SOURCE=static (or auto without PROGRAM_ID)
TOKEN_INITIAL_SUPPLY=1000000000000000  # base units at launch (pump.fun: 1e9 tokens, 6 dp). Denominator of burnedPct / supplyReductionPct. Legacy alias: TOKEN_SUPPLY_STATIC

# --- Rate limits (per IP per minute, in-memory) ---
RATE_LIMIT_UPLOADS_PER_MIN=10
RATE_LIMIT_QUOTE_PER_MIN=120

# --- Keeper (pnpm --filter @mpb/services keeper) ---
KEEPER_LIVE=0                     # !!! 1 = actually send transactions. Default dry-run only logs.
KEEPER_KEYPAIR=                   # keeper secret key: base58 or JSON byte array. REQUIRED when KEEPER_LIVE=1
KEEPER_BUYBACK_ENABLED=1          # 0 = crank only (e.g. while someone runs a manual buyback)
KEEPER_BUYBACK_MAX_SPOT_OVER_EMA_PCT=10   # skip if spot is/would be > this % above the fast EMA (program pauses token pay at 15%)
KEEPER_BUYBACK_MAX_QUOTE_FRACTION_BPS=50  # one buy <= 0.5% of the curve/pool effective quote reserves (~1% price impact)
KEEPER_BUYBACK_MAX_RUN_PRICE_MOVE_PCT=5   # cap the projected cumulative spot move of one run
KEEPER_OUTSTANDING_GRACE_SECS=900 # an open release older than this is resumed (buy+record) or refunded (record 0,0)
KEEPER_CRANK_INTERVAL_MS=45000      # chain wants 30-60 s; min 30 s between cranks on-chain
KEEPER_BUYBACK_INTERVAL_MS=900000
KEEPER_LOOKUP_TABLE=              # keeper-owned Address Lookup Table for the atomic buyback tx; found by authority or created if unset
KEEPER_BUYBACK_FIRST_DELAY_MS=90000   # first run soon after (re)start, so frequent redeploys can't starve buybacks
KEEPER_BUYBACK_JITTER_MS=300000   # random extra delay per run (MEV: unpredictable timing)
KEEPER_BUYBACK_MIN_CHUNK_LAMPORTS=50000000
KEEPER_BUYBACK_MAX_CHUNK_LAMPORTS=2000000000
KEEPER_BUYBACK_MAX_PER_RUN_LAMPORTS=10000000000
KEEPER_BUYBACK_SLIPPAGE_BPS=100
KEEPER_BUYBACK_MAX_PRICE_IMPACT_PCT=1.0
KEEPER_VAULT_RESERVE_LAMPORTS=10000000
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JITO_ENABLED=0                    # 1 = submit as Jito bundle with a tip instead of plain sendTransaction
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=10000

# --- Container health (set by the Dockerfile; override only if needed) ---
HEARTBEAT_FILE=                   # indexer/keeper heartbeat file checked by the Docker HEALTHCHECK

# --- Seed (pnpm --filter @mpb/services seed) ---
SEED_ALLOW_PRODUCTION=0           # 1 = allow seeding (WIPES ALL TABLES) when NODE_ENV=production (demo deployments only)
SEED_ADS=300
SEED_RANDOM=1337
