# ---- client (baked into the bundle at build time) ----
# Leave unset to run against the built-in mock adapter (deterministic canvas + fake live events).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ---- server only (never exposed to the browser) ----
# Upstream JSON-RPC URL (may contain an API key). The browser talks to /api/rpc, which proxies here.
SOLANA_RPC=https://api.devnet.solana.com
# Optional overrides for the /api/rpc rate limit
# RPC_RATE_PER_MIN=120
# RPC_SEND_PER_MIN=12
